<style>
    .top-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-around;
        align-items: center;
        border: 2px solid var(--border-color);
        padding: 15px 20px;
        margin-bottom: 25px;
        font-size: 1.1rem;
        font-weight: bold;
        background: #0a0a0a;
    }

    .stat-box {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--accent-color);
        padding: 5px 10px;
    }

    .stat-box span {
        color: #fff;
    }

    .vitals-box {
        border: 2px solid var(--accent-color);
        background: #0a0a0a;
        padding: 20px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-around;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        box-shadow: 0 0 10px rgba(255, 230, 0, 0.15);
    }

    .vitals-item {
        text-align: center;
    }

    .vitals-title {
        color: var(--accent-color);
        font-size: 1.2rem;
        font-weight: bold;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .grid-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 35px;
    }

    @media (max-width: 900px) {
        .grid-container {
            grid-template-columns: 1fr;
        }
    }

    .section-title {
        color: var(--accent-color);
        font-size: 1.8rem;
        text-transform: uppercase;
        margin-bottom: 12px;
        letter-spacing: 1px;
        border-bottom: 1px solid var(--accent-color);
        padding-bottom: 5px;
    }

    .sub-title {
        color: var(--muted-color);
        font-size: 0.95rem;
        margin-bottom: 15px;
    }

    .content-box {
        margin-bottom: 30px;
        background: #0a0a0a;
        border: 1px solid #222;
        padding: 25px;
        position: relative;
    }

    ul {
        list-style-type: square;
        padding-left: 20px;
        line-height: 1.8;
    }

    li {
        margin-bottom: 8px;
    }

    .highlight {
        font-weight: bold;
        color: #fff;
    }

    .toolbar {
        background: #111;
        border: 1px solid var(--border-color);
        padding: 15px 20px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .btn {
        background: var(--accent-color);
        color: #000;
        border: none;
        padding: 8px 16px;
        font-weight: bold;
        font-family: inherit;
        cursor: pointer;
        text-transform: uppercase;
    }

    .btn-green {
        background: #00ff66;
        color: #000;
        border: none;
        padding: 8px 16px;
        font-weight: bold;
        font-family: inherit;
        cursor: pointer;
        text-transform: uppercase;
    }

    .btn-outline {
        background: transparent;
        color: var(--accent-color);
        border: 1px solid var(--accent-color);
        padding: 8px 16px;
        font-weight: bold;
        font-family: inherit;
        cursor: pointer;
    }

    .btn-danger-small {
        background: transparent;
        color: #ff3366;
        border: 1px solid #ff3366;
        padding: 2px 6px;
        font-size: 0.85rem;
        cursor: pointer;
        font-family: inherit;
        line-height: 1;
    }

    .btn-danger-small:hover {
        background: rgba(255, 51, 102, 0.2);
    }

    input[type="number"] {
        width: 52px;
        background: #000;
        border: 1px solid var(--accent-color);
        color: var(--accent-color);
        text-align: center;
        font-size: 1.05rem;
        font-family: inherit;
        padding: 4px;
    }

    input[type="number"]:focus, input[type="text"]:focus, textarea:focus {
        outline: none;
        box-shadow: 0 0 5px var(--accent-color);
    }

    .edit-input {
        background: #000;
        border: 1px solid var(--accent-color);
        color: #fff;
        padding: 4px 8px;
        font-family: inherit;
        font-size: 0.95rem;
        margin-bottom: 5px;
        box-sizing: border-box;
    }

    textarea.edit-input {
        width: 100%;
        min-height: 42px;
        resize: vertical;
        overflow-y: hidden;
        line-height: 1.4;
        font-size: 0.95rem;
    }

    .editable-field {
        position: relative;
        cursor: pointer;
        transition: background 0.15s ease;
        border-bottom: 1px dotted transparent;
    }

    .can-edit .editable-field:hover {
        background: rgba(255, 230, 0, 0.08);
        border-bottom-color: var(--accent-color);
    }

    /* Gear Table */
    .gear-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
        text-align: left;
    }

    .gear-table th {
        color: var(--accent-color);
        border-bottom: 2px solid var(--accent-color);
        padding: 8px 10px;
        font-size: 0.95rem;
    }

    .gear-table td {
        border-bottom: 1px solid #222;
        padding: 10px;
        line-height: 1.5;
    }

    .badge {
        background: #151515;
        border: 1px solid var(--accent-color);
        color: var(--accent-color);
        padding: 2px 6px;
        font-size: 0.85rem;
        font-weight: bold;
    }

    .toggle-edit-btn {
        font-size: 0.75rem;
        padding: 3px 8px;
        background: transparent;
        border: 1px solid var(--accent-color);
        color: var(--accent-color);
        cursor: pointer;
    }
</style>

<div id="character-sheet-container">
{{if not .IsModal}}
<div style="margin: 10px 0 20px 0; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #222; padding-bottom: 8px;">
    <a href="/" style="color: var(--accent-color); text-decoration: none; font-weight: bold; font-size: 0.85rem; text-transform: uppercase;">⬅️ Back to Home</a>
    <span style="font-size: 0.85rem; color: var(--muted-color); text-transform: uppercase; display:inline-flex; align-items:center; gap:6px;">
        <img src="/favicon.svg" alt="logo" style="height:20px; width:20px; border-radius:3px; border:1px solid var(--accent-color);">
        CY_BORGER Operator Sheet
    </span>
</div>
{{end}}

{{if .Character.IsDead}}
<div style="background: #20000a; border: 2px solid #ff0055; padding: 15px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; box-shadow: 0 0 18px rgba(255,0,85,0.35);">
    <div>
        <div style="color: #ff0055; font-weight: bold; font-size: 1.15rem; text-transform: uppercase; display:flex; align-items:center; gap:8px;">
            🪦 OPERATOR FLATLINED {{if not .Character.DiedAt.IsZero}}ON {{.Character.DiedAt.Format "2006-01-02 15:04:05"}}{{end}}
        </div>
        <div style="color: #ff99bb; font-size: 0.9rem; margin-top: 6px; font-style: italic;">
            "{{.Character.DeathNote}}"
        </div>
    </div>
    {{if or .CanEdit .IsGM}}
    <form action="/character/{{.Character.ID}}/revive" method="POST" hx-post="/character/{{.Character.ID}}/revive" hx-target="#character-sheet-container" hx-swap="outerHTML">
        <button type="submit" class="btn-outline" style="font-size: 0.85rem; border-color:#ff0055; color:#ff0055;">⚡ REVIVE OPERATOR</button>
    </form>
    {{end}}
</div>
{{end}}

{{if and .CanEdit (not .Character.IsSaved)}}
<div style="background: #0d1f12; border: 2px solid #00ff66; padding: 15px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; box-shadow: 0 0 15px rgba(0,255,102,0.2);">
    <div>
        <div style="color: #00ff66; font-weight: bold; font-size: 1.1rem; text-transform: uppercase;">⚡ DRAFT CHARACTER PREVIEW</div>
        <div style="color: #aaa; font-size: 0.85rem; margin-top: 4px;">Reroll as many times as you like. Click "KEEP THIS CHARACTER" to save it permanently!</div>
    </div>
    <form action="/character/{{.Character.ID}}/keep" method="POST" hx-post="/character/{{.Character.ID}}/keep" hx-target="#character-sheet-container" hx-swap="outerHTML">
        <button type="submit" class="btn-green" style="font-size: 1rem; padding: 10px 22px;">💾 KEEP THIS CHARACTER</button>
    </form>
</div>
{{end}}

<div class="toolbar">
    <div>
        <span>CHARACTER ID: <strong style="color:var(--accent-color)">{{.Character.ID}}</strong></span>
        {{if .CanEdit}}
        <span style="margin-left: 10px; color: #00ff66;">[EDIT MODE]</span>
        <button class="btn-outline" style="font-size: 0.8rem; margin-left: 8px;" onclick="copyText(window.location.origin + '/character/{{.Character.ID}}?code={{.Character.EditCode}}', this)">Copy Edit Link</button>
        <script>
            if (window.cyStore) {
                cyStore.saveCharEdit('{{.Character.ID}}', '{{.Character.EditCode}}', '{{.Character.Name}}');
            }
        </script>
        {{else}}
        <span style="margin-left: 10px; color: #ff3366;">[READ-ONLY]</span>
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                if (window.cyStore) {
                    const chars = cyStore.getCharEdits();
                    if (chars['{{.Character.ID}}'] && chars['{{.Character.ID}}'].editCode) {
                        const code = chars['{{.Character.ID}}'].editCode;
                        const form = document.querySelector('form[action="/character/{{.Character.ID}}/auth"]');
                        if (form) {
                            form.querySelector('input[name="edit_code"]').value = code;
                            form.submit();
                        }
                    }
                }
            });
        </script>
        {{end}}
        <button class="btn-outline" style="font-size: 0.8rem; margin-left: 8px;" onclick="copyText(window.location.origin + '/character/{{.Character.ID}}', this)">Copy View Link</button>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
        {{if .Character.GameID}}
            <span style="color:#00ff66; font-weight:bold;">IN GAME: <a href="/game/{{.Game.ID}}" style="color:var(--accent-color)">{{.Game.Name}}</a></span>
        {{else if .ActiveGame}}
            <form action="/character/{{.Character.ID}}/join" method="POST" style="display:inline-flex;">
                <input type="hidden" name="invite_code" value="{{.ActiveGame.InviteCode}}">
                <button type="submit" class="btn-green">+ ADD TO GAME "{{.ActiveGame.Name}}"</button>
            </form>
        {{else if .CanEdit}}
            <form action="/character/{{.Character.ID}}/join" method="POST" style="display:inline-flex; gap: 5px;">
                <input type="text" name="invite_code" placeholder="Game Invite Code" style="background:#000; border:1px solid var(--accent-color); color:#fff; padding:5px;">
                <button type="submit" class="btn">Join Game</button>
            </form>
        {{end}}

        {{if not .CanEdit}}
        <form action="/character/{{.Character.ID}}/auth" method="POST" style="display:inline-flex; gap: 5px;">
            <input type="text" name="edit_code" placeholder="Enter Edit Code" style="background:#000; border:1px solid var(--accent-color); color:#fff; padding:5px; width:120px;">
            <button type="submit" class="btn-outline">Unlock Edit</button>
        </form>
        {{end}}

        <button class="btn-outline" onclick="randomizeThemeColor()">🌈 Color</button>
        <button class="btn" hx-post="/character/generate" hx-target="#character-sheet-container" hx-push-url="true">
            🎲 REROLL NEW
        </button>

        {{if or .CanEdit .IsGM}}
        {{if not .Character.IsDead}}
        <button class="btn-danger-small" style="font-size: 0.8rem; padding: 7px 12px; margin-left: 5px; background: #400015; border-color: #ff0055; color: #ff0055;" onclick="toggleEditSection('kill-char', 'flex')">💀 FLATLINE</button>
        
        <div id="kill-char-edit" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
            <div style="background:#0a0a0a; border:2px solid #ff0055; max-width:450px; width:90%; padding:25px; box-shadow:0 0 20px rgba(255,0,85,0.4); text-align:center;">
                <h2 style="color:#ff0055; margin-bottom:10px;">💀 FLATLINE OPERATOR</h2>
                <p style="color:#aaa; font-size:0.9rem; margin-bottom:15px; line-height:1.4;">
                    Mark <strong>{{.Character.Name}}</strong> as deceased in the GRAVEYARD. Add cause of death or final words:
                </p>
                <form action="/character/{{.Character.ID}}/kill" method="POST" hx-post="/character/{{.Character.ID}}/kill" hx-target="#character-sheet-container" hx-swap="outerHTML" style="display:flex; flex-direction:column; gap:12px;">
                    <textarea name="death_note" placeholder="e.g. Flatlined by Cy-Spider in Sector 4" class="edit-input auto-stretch" style="border-color:#ff0055; font-size:0.95rem; min-height:60px;"></textarea>
                    <div style="display:flex; gap:10px; justify-content:center; margin-top:5px;">
                        <button type="button" class="btn-outline" onclick="toggleEditSection('kill-char')">Cancel</button>
                        <button type="submit" class="btn" style="background:#ff0055; color:#fff; border-color:#ff0055;">💀 FLATLINE</button>
                    </div>
                </form>
            </div>
        </div>
        {{end}}
        {{end}}

        {{if .CanEdit}}
        <button class="btn-danger-small" style="font-size: 0.8rem; padding: 7px 12px; margin-left: 5px;" onclick="toggleEditSection('delete-char', 'flex')">💣 DELETE</button>
        
        <div id="delete-char-edit" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
            <div style="background:#0a0a0a; border:2px solid #ff3366; max-width:450px; width:90%; padding:25px; box-shadow:0 0 20px rgba(255,51,102,0.4); text-align:center;">
                <h2 style="color:#ff3366; margin-bottom:10px;">⚠️ PERMANENT DELETION</h2>
                <p style="color:#aaa; font-size:0.9rem; margin-bottom:15px; line-height:1.4;">
                    This action cannot be undone. To delete <strong>{{.Character.Name}}</strong>, type the character name below:
                </p>
                <form action="/character/{{.Character.ID}}/delete" method="POST" hx-post="/character/{{.Character.ID}}/delete" style="display:flex; flex-direction:column; gap:12px;">
                    <input type="text" name="confirm_name" placeholder="Type {{.Character.Name}} to confirm" required class="edit-input" style="border-color:#ff3366; text-align:center; font-size:1rem;">
                    <div style="display:flex; gap:10px; justify-content:center; margin-top:5px;">
                        <button type="button" class="btn-outline" onclick="toggleEditSection('delete-char')">Cancel</button>
                        <button type="submit" class="btn" style="background:#ff3366; color:#fff;">💣 PERMANENTLY DELETE</button>
                    </div>
                </form>
            </div>
        </div>
        {{end}}
    </div>
</div>

<!-- Top Stats Bar (Strength, Agility, Presence, Toughness, Knowledge) -->
<div class="top-bar">
    {{range $name, $stat := .Character.Abilities}}
    <div class="stat-box">
        <span>{{$name}}:</span> 
        {{if $.CanEdit}}
        <form id="stat-form-{{$name}}" style="display:inline-flex; align-items:center; gap:2px;">
            <input type="hidden" name="stat_name" value="{{$name}}">
            <input type="number" name="stat_current" value="{{$stat.Current}}"
                   hx-put="/character/{{$.Character.ID}}/update_stat"
                   hx-include="#stat-form-{{$name}}"
                   hx-trigger="change, input delay:300ms"
                   hx-swap="none"> / 
            <input type="number" name="stat_max" value="{{$stat.Max}}"
                   hx-put="/character/{{$.Character.ID}}/update_stat"
                   hx-include="#stat-form-{{$name}}"
                   hx-trigger="change, input delay:300ms"
                   hx-swap="none">
        </form>
        {{else}}
        <span>{{if gt $stat.Current 0}}+{{end}}{{$stat.Current}} (max {{$stat.Max}})</span>
        {{end}}
    </div>
    {{end}}
</div>

<!-- Dedicated Vitals & Glitches Box -->
<div class="vitals-box">
    <div class="vitals-item">
        <div class="vitals-title">❤️ HIT POINTS (HP)</div>
        {{if .CanEdit}}
        <form id="hp-form" style="display:inline-flex; align-items:center; gap:4px;">
            <input type="number" name="hp_current" value="{{.Character.HP.Current}}" style="font-size:1.3rem; width:58px;"
                   hx-put="/character/{{.Character.ID}}/update_hp"
                   hx-include="#hp-form"
                   hx-trigger="change, input delay:300ms"
                   hx-swap="none"> 
            <span style="font-size:1.3rem;">/</span> 
            <input type="number" name="hp_max" value="{{.Character.HP.Max}}" style="font-size:1.3rem; width:58px;"
                   hx-put="/character/{{.Character.ID}}/update_hp"
                   hx-include="#hp-form"
                   hx-trigger="change, input delay:300ms"
                   hx-swap="none">
        </form>
        {{else}}
        <div style="font-size: 1.5rem; font-weight: bold;">{{.Character.HP.Current}} / {{.Character.HP.Max}}</div>
        {{end}}
    </div>

    <div class="vitals-item">
        <div class="vitals-title">⚡ GLITCHES</div>
        {{if .CanEdit}}
        <form id="glitches-form" style="display:inline-flex; align-items:center; gap:4px;">
            <input type="number" name="glitches_current" value="{{.Character.Glitches.Current}}" style="font-size:1.3rem; width:58px;"
                   hx-put="/character/{{.Character.ID}}/update_glitches"
                   hx-include="#glitches-form"
                   hx-trigger="change, input delay:300ms"
                   hx-swap="none"> 
            <span style="font-size:1.3rem;">/</span> 
            <input type="number" name="glitches_max" value="{{.Character.Glitches.Max}}" style="font-size:1.3rem; width:58px;"
                   hx-put="/character/{{.Character.ID}}/update_glitches"
                   hx-include="#glitches-form"
                   hx-trigger="change, input delay:300ms"
                   hx-swap="none">
            <span style="color:var(--muted-color)">({{.Character.GlitchDie}})</span>
        </form>
        {{else}}
        <div style="font-size: 1.5rem; font-weight: bold;">{{.Character.Glitches.Current}} / {{.Character.Glitches.Max}} <span style="font-size:1rem; color:var(--muted-color)">({{.Character.GlitchDie}})</span></div>
        {{end}}
    </div>

    <div class="vitals-item">
        <div class="vitals-title">💰 CREDITS</div>
        {{if .CanEdit}}
        <form id="creds-form" style="display:inline-flex; align-items:center; gap:4px;">
            <input type="number" name="value" value="{{.Character.Creds}}" style="font-size:1.3rem; width:95px;"
                   hx-put="/character/{{.Character.ID}}/update_field"
                   hx-include="#creds-form"
                   hx-trigger="change, input delay:300ms"
                   hx-vals='{"field": "creds"}'
                   hx-swap="none"> <span style="font-size:1.3rem; color:var(--accent-color)">¤</span>
        </form>
        {{else}}
        <div style="font-size: 1.5rem; font-weight: bold; color:var(--accent-color)">{{.Character.Creds}}¤</div>
        {{end}}
    </div>
</div>

<!-- Edit Form Toggle & Auto-Stretch Script -->
<script>
function toggleEditSection(sectionId, displayStyle = 'block') {
    const editEl = document.getElementById(sectionId + '-edit');
    const viewEl = document.getElementById(sectionId + '-view');
    if (editEl) {
        const isHidden = editEl.style.display === 'none' || editEl.style.display === '';
        editEl.style.display = isHidden ? displayStyle : 'none';
        if (viewEl) {
            viewEl.style.display = isHidden ? 'none' : 'block';
        }
        if (isHidden) {
            editEl.querySelectorAll('textarea.auto-stretch').forEach(autoResizeTextarea);
        }
    }
}

function autoResizeTextarea(el) {
    el.style.height = 'auto';
    el.style.height = Math.max(el.scrollHeight + 4, 42) + 'px';
}

document.addEventListener("input", function(e) {
    if (e.target.tagName === 'TEXTAREA' && e.target.classList.contains('auto-stretch')) {
        autoResizeTextarea(e.target);
    }
});
</script>

<!-- 2x2 Grid Layout -->
<div class="grid-container {{if .CanEdit}}can-edit{{end}}">
    <!-- Top Left: Identity -->
    <div class="content-box">
        {{if .CanEdit}}
        <div style="position:absolute; top:15px; right:15px;">
            <button type="button" onclick="toggleEditSection('identity')" class="toggle-edit-btn">✏️ Edit Text</button>
        </div>
        {{end}}

        <!-- Clean Text View (Default) -->
        <div id="identity-view">
            <h1 style="color: var(--accent-color); font-size: 2.2rem; margin-bottom:5px;">YOU ARE {{.Character.Name}}</h1>
            <div class="sub-title">{{if .Character.Handle}}@{{.Character.Handle}}{{else}}<span style="color:var(--muted-color)">[No Handle]</span>{{end}}</div>
            <p style="line-height: 1.7; margin-bottom: 15px;">
                {{if or .Character.Style .Character.Feature .Character.Want .Character.Quirk .Character.Obsession}}
                A <span class="highlight">{{.Character.Style}}</span> <span class="highlight">{{.Character.Class.Name}}</span>; 
                {{.Character.Feature}}. {{.Character.Want}} {{.Character.Quirk}} {{.Character.Obsession}}
                {{else}}
                <span style="color:var(--muted-color); font-style:italic;">No bio or background details entered yet. Click "✏️ Edit Text" to customize.</span>
                {{end}}
            </p>
            {{if .Character.Debt}}
            <p style="color: var(--accent-color); font-weight: bold; font-size:1.05rem;">
                {{.Character.Debt}}
            </p>
            {{end}}
        </div>

        <!-- Editable Form (Hidden until Edit toggled) -->
        {{if .CanEdit}}
        <div id="identity-edit" style="display:none; margin-top:10px;">
            <form hx-post="/character/{{.Character.ID}}/update_field" hx-target="#character-sheet-container" hx-swap="outerHTML" onsubmit="return false;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <span style="color:var(--accent-color); font-weight:bold; font-size:0.85rem;">EDIT IDENTITY & BIO</span>
                    <div style="display:flex; gap:6px;">
                        <button type="button" onclick="toggleEditSection('identity')" class="btn-outline" style="font-size:0.75rem; padding:2px 8px;">Cancel</button>
                        <button type="submit" class="btn" style="font-size:0.75rem; padding:2px 8px;">💾 Save Changes</button>
                    </div>
                </div>
                <div style="margin-bottom: 8px;">
                    <label style="font-size:0.75rem; color:var(--accent-color); font-weight:bold; display:block;">NAME</label>
                    <input type="text" name="name" value="{{.Character.Name}}" class="edit-input" style="font-size: 1.2rem; font-weight:bold; color:var(--accent-color); width:100%;">
                </div>
                <div style="margin-bottom: 10px;">
                    <label style="font-size:0.75rem; color:var(--muted-color); font-weight:bold; display:block;">HANDLE</label>
                    <input type="text" name="handle" value="{{.Character.Handle}}" class="edit-input" style="width:100%; color:var(--muted-color);">
                </div>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; margin-bottom:8px;">
                    <div>
                        <label style="font-size:0.75rem; color:#aaa; display:block;">STYLE</label>
                        <textarea name="style" class="edit-input auto-stretch" oninput="autoResizeTextarea(this)">{{.Character.Style}}</textarea>
                    </div>
                    <div>
                        <label style="font-size:0.75rem; color:#aaa; display:block;">FEATURE</label>
                        <textarea name="feature" class="edit-input auto-stretch" oninput="autoResizeTextarea(this)">{{.Character.Feature}}</textarea>
                    </div>
                </div>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; margin-bottom:8px;">
                    <div>
                        <label style="font-size:0.75rem; color:#aaa; display:block;">WANT</label>
                        <textarea name="want" class="edit-input auto-stretch" oninput="autoResizeTextarea(this)">{{.Character.Want}}</textarea>
                    </div>
                    <div>
                        <label style="font-size:0.75rem; color:#aaa; display:block;">QUIRK</label>
                        <textarea name="quirk" class="edit-input auto-stretch" oninput="autoResizeTextarea(this)">{{.Character.Quirk}}</textarea>
                    </div>
                </div>
                <div style="margin-bottom:8px;">
                    <label style="font-size:0.75rem; color:#aaa; display:block;">OBSESSION</label>
                    <textarea name="obsession" class="edit-input auto-stretch" oninput="autoResizeTextarea(this)">{{.Character.Obsession}}</textarea>
                </div>
                <div style="margin-bottom:12px;">
                    <label style="font-size:0.75rem; color:var(--accent-color); font-weight:bold; display:block;">DEBT</label>
                    <textarea name="debt" class="edit-input auto-stretch" style="color:var(--accent-color);" oninput="autoResizeTextarea(this)">{{.Character.Debt}}</textarea>
                </div>
                <div style="display:flex; gap:8px; justify-content:flex-end;">
                    <button type="button" onclick="toggleEditSection('identity')" class="btn-outline" style="font-size:0.8rem; padding:4px 10px;">Cancel</button>
                    <button type="submit" class="btn" style="font-size:0.8rem; padding:4px 10px;">💾 Save Changes</button>
                </div>
            </form>
        </div>
        {{end}}
    </div>

    <!-- Top Right: Class -->
    <div class="content-box">
        {{if .CanEdit}}
        <div style="position:absolute; top:15px; right:15px;">
            <button type="button" onclick="toggleEditSection('class')" class="toggle-edit-btn">✏️ Edit Class</button>
        </div>
        {{end}}

        <!-- Clean Text View (Default) -->
        <div id="class-view">
            <h2 class="section-title">{{.Character.Class.Name}}</h2>
            <div class="sub-title" style="color: var(--accent-color); font-weight:bold;">{{.Character.Class.Glitch}}</div>
            <p style="line-height: 1.7; font-style: italic; margin-bottom: 15px;">
                {{.Character.Class.Description}}
            </p>
            {{if .Character.Class.Origin}}
            <p style="margin-bottom: 10px; line-height:1.5;"><strong>Origin:</strong> {{.Character.Class.Origin}}</p>
            {{end}}
            {{if .Character.Class.Gift}}
            <p style="margin-bottom: 10px; line-height:1.5;"><strong>Class Gift/Weapon:</strong> {{.Character.Class.Gift}}</p>
            {{end}}
        </div>

        <!-- Editable Form (Hidden until Edit toggled) -->
        {{if .CanEdit}}
        <div id="class-edit" style="display:none; margin-top:10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <span style="color:var(--accent-color); font-weight:bold; font-size:0.85rem;">EDIT CLASS DETAILS</span>
                <div style="display:flex; gap:6px;">
                    <button type="button" onclick="toggleEditSection('class')" class="btn-outline" style="font-size:0.75rem; padding:2px 8px;">Cancel</button>
                    <button type="button" class="btn" style="font-size:0.75rem; padding:2px 8px;"
                            hx-post="/character/{{.Character.ID}}/update_field"
                            hx-include="#class-edit"
                            hx-target="#character-sheet-container"
                            hx-swap="outerHTML">💾 Save Changes</button>
                </div>
            </div>
            <div style="margin-bottom:8px;">
                <label style="font-size:0.75rem; color:var(--accent-color); font-weight:bold; display:block;">CLASS NAME</label>
                <input type="text" name="class_name" value="{{.Character.Class.Name}}" class="edit-input" style="font-size:1.2rem; font-weight:bold; color:var(--accent-color); width:100%;">
            </div>
            <div style="margin-bottom:8px;">
                <label style="font-size:0.75rem; color:var(--accent-color); display:block;">CLASS GLITCH</label>
                <input type="text" name="class_glitch" value="{{.Character.Class.Glitch}}" class="edit-input" style="width:100%; color:var(--accent-color);">
            </div>
            <div style="margin-bottom:8px;">
                <label style="font-size:0.75rem; color:#aaa; display:block;">DESCRIPTION</label>
                <textarea name="class_description" class="edit-input auto-stretch" oninput="autoResizeTextarea(this)">{{.Character.Class.Description}}</textarea>
            </div>
            <div style="margin-bottom:8px;">
                <label style="font-size:0.75rem; color:#aaa; display:block;">ORIGIN</label>
                <textarea name="class_origin" class="edit-input auto-stretch" oninput="autoResizeTextarea(this)">{{.Character.Class.Origin}}</textarea>
            </div>
            <div style="margin-bottom:12px;">
                <label style="font-size:0.75rem; color:#aaa; display:block;">CLASS GIFT / WEAPON</label>
                <textarea name="class_gift" class="edit-input auto-stretch" oninput="autoResizeTextarea(this)">{{.Character.Class.Gift}}</textarea>
            </div>
            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button type="button" onclick="toggleEditSection('class')" class="btn-outline" style="font-size:0.8rem; padding:4px 10px;">Cancel</button>
                <button type="button" class="btn" style="font-size:0.8rem; padding:4px 10px;"
                        hx-post="/character/{{.Character.ID}}/update_field"
                        hx-include="#class-edit"
                        hx-target="#character-sheet-container"
                        hx-swap="outerHTML">💾 Save Changes</button>
            </div>
        </div>
        {{end}}
    </div>

    <!-- Bottom Left: Gear (Formatted as Table!) -->
    <div class="content-box">
        <h2 class="section-title">GEAR & ARSENAL</h2>

        <table class="gear-table">
            <thead>
                <tr>
                    <th>ITEM / WEAPON</th>
                    <th>DAMAGE / TIER</th>
                    <th>NOTES & EFFECT</th>
                    {{if .CanEdit}}<th>ACTIONS</th>{{end}}
                </tr>
            </thead>
            <tbody>
                {{range $i, $w := .Character.Weapons}}
                <tr>
                    <td class="highlight">⚔️ {{$w.Name}}</td>
                    <td>
                        <span class="badge">{{$w.Damage}}</span>
                        {{if $w.Hands}}<span style="font-size: 0.75rem; color: #888; margin-left: 4px;">[{{$w.Hands}}]</span>{{end}}
                    </td>
                    <td>{{$w.Description}}</td>
                    {{if $.CanEdit}}
                    <td>
                        <form action="/character/{{$.Character.ID}}/delete_item" method="POST"
                              hx-post="/character/{{$.Character.ID}}/delete_item"
                              hx-target="#character-sheet-container" hx-swap="outerHTML"
                              hx-confirm="Are you sure you want to delete this weapon?"
                              style="display:inline;">
                            <input type="hidden" name="type" value="weapon">
                            <input type="hidden" name="index" value="{{$i}}">
                            <button type="submit" class="btn-danger-small" title="Delete weapon">🗑️</button>
                        </form>
                    </td>
                    {{end}}
                </tr>
                {{end}}
                {{range $i, $a := .Character.Armor}}
                <tr>
                    <td class="highlight">🛡️ {{$a.Name}}</td>
                    <td><span class="badge">{{$a.Tier}}</span></td>
                    <td>{{$a.Reduction}}</td>
                    {{if $.CanEdit}}
                    <td>
                        <form action="/character/{{$.Character.ID}}/delete_item" method="POST"
                              hx-post="/character/{{$.Character.ID}}/delete_item"
                              hx-target="#character-sheet-container" hx-swap="outerHTML"
                              hx-confirm="Are you sure you want to delete this armor?"
                              style="display:inline;">
                            <input type="hidden" name="type" value="armor">
                            <input type="hidden" name="index" value="{{$i}}">
                            <button type="submit" class="btn-danger-small" title="Delete armor">🗑️</button>
                        </form>
                    </td>
                    {{end}}
                </tr>
                {{end}}
            </tbody>
        </table>

        {{if .CanEdit}}
        <div style="margin-top:10px; margin-bottom:15px;">
            <button type="button" onclick="toggleEditSection('gear-add')" class="toggle-edit-btn">+ Add Weapon / Armor</button>
            <div id="gear-add-edit" style="display:none; margin-top:10px;">
                <div style="background:#111; border:1px dashed #333; padding:10px; margin-bottom:10px;">
                    <div style="font-size:0.8rem; color:var(--accent-color); font-weight:bold; margin-bottom:6px;">+ ADD WEAPON</div>
                    <form action="/character/{{.Character.ID}}/add_item" method="POST" hx-post="/character/{{.Character.ID}}/add_item" hx-target="#character-sheet-container" hx-swap="outerHTML" style="display:flex; gap:5px; flex-wrap:wrap;">
                        <input type="hidden" name="type" value="weapon">
                        <input type="text" name="name" placeholder="Weapon Name" style="flex:1; min-width:120px;" class="edit-input" required>
                        <input type="text" name="damage" placeholder="Damage (e.g. d6)" style="width:90px;" class="edit-input">
                        <input type="text" name="description" placeholder="Notes" style="flex:1; min-width:120px;" class="edit-input">
                        <button type="submit" class="btn" style="padding:4px 10px; font-size:0.8rem;">+ Add</button>
                    </form>
                </div>
                <div style="background:#111; border:1px dashed #333; padding:10px;">
                    <div style="font-size:0.8rem; color:var(--accent-color); font-weight:bold; margin-bottom:6px;">+ ADD ARMOR</div>
                    <form action="/character/{{.Character.ID}}/add_item" method="POST" hx-post="/character/{{.Character.ID}}/add_item" hx-target="#character-sheet-container" hx-swap="outerHTML" style="display:flex; gap:5px; flex-wrap:wrap;">
                        <input type="hidden" name="type" value="armor">
                        <input type="text" name="name" placeholder="Armor Name" style="flex:1; min-width:120px;" class="edit-input" required>
                        <input type="text" name="tier" placeholder="Tier (e.g. d4)" style="width:90px;" class="edit-input">
                        <input type="text" name="reduction" placeholder="Notes/Reduction" style="flex:1; min-width:120px;" class="edit-input">
                        <button type="submit" class="btn" style="padding:4px 10px; font-size:0.8rem;">+ Add</button>
                    </form>
                </div>
            </div>
        </div>
        {{end}}

        <h3 style="color:var(--accent-color); font-size:1.1rem; margin-top:15px; margin-bottom:8px;">INVENTORY</h3>
        <ul>
            {{range $i, $item := .Character.Gear}}
            <li style="display:flex; justify-content:space-between; align-items:center;">
                <span>{{$item}}</span>
                {{if $.CanEdit}}
                <form action="/character/{{$.Character.ID}}/delete_item" method="POST"
                      hx-post="/character/{{$.Character.ID}}/delete_item"
                      hx-target="#character-sheet-container" hx-swap="outerHTML"
                      hx-confirm="Are you sure you want to delete this inventory item?"
                      style="display:inline;">
                    <input type="hidden" name="type" value="gear">
                    <input type="hidden" name="index" value="{{$i}}">
                    <button type="submit" class="btn-danger-small" title="Delete item">🗑️</button>
                </form>
                {{end}}
            </li>
            {{end}}
        </ul>
        {{if .CanEdit}}
        <form action="/character/{{.Character.ID}}/add_item" method="POST" hx-post="/character/{{.Character.ID}}/add_item" hx-target="#character-sheet-container" hx-swap="outerHTML" style="display:flex; gap:5px; margin-top:8px;">
            <input type="hidden" name="type" value="gear">
            <input type="text" name="item" placeholder="New inventory item..." class="edit-input" style="flex:1;" required>
            <button type="submit" class="btn" style="padding:4px 10px; font-size:0.8rem;">+ Add Item</button>
        </form>
        {{end}}
    </div>

    <!-- Bottom Right: Cybertech & Apps -->
    <div class="content-box">
        <h2 class="section-title">CYBERTECH & APPS</h2>
        
        <h3 style="color:var(--accent-color); font-size:1.1rem; margin-bottom: 8px;">CYBERWARE</h3>
        <ul>
            {{range $i, $item := .Character.Cybertech}}
            <li style="display:flex; justify-content:space-between; align-items:center;">
                <span>{{$item}}</span>
                {{if $.CanEdit}}
                <form action="/character/{{$.Character.ID}}/delete_item" method="POST"
                      hx-post="/character/{{$.Character.ID}}/delete_item"
                      hx-target="#character-sheet-container" hx-swap="outerHTML"
                      hx-confirm="Are you sure you want to delete this cyberware?"
                      style="display:inline;">
                    <input type="hidden" name="type" value="cybertech">
                    <input type="hidden" name="index" value="{{$i}}">
                    <button type="submit" class="btn-danger-small" title="Delete cyberware">🗑️</button>
                </form>
                {{end}}
            </li>
            {{else}}
            <li style="color:var(--muted-color); list-style:none;">None</li>
            {{end}}
        </ul>
        {{if .CanEdit}}
        <form action="/character/{{.Character.ID}}/add_item" method="POST" hx-post="/character/{{.Character.ID}}/add_item" hx-target="#character-sheet-container" hx-swap="outerHTML" style="display:flex; gap:5px; margin-top:8px; margin-bottom:15px;">
            <input type="hidden" name="type" value="cybertech">
            <input type="text" name="item" placeholder="New Cyberware..." class="edit-input" style="flex:1;" required>
            <button type="submit" class="btn" style="padding:4px 10px; font-size:0.8rem;">+ Add Cybertech</button>
        </form>
        {{end}}

        <h3 style="color:var(--accent-color); font-size:1.1rem; margin-top: 20px; margin-bottom: 8px;">NANO & APPS</h3>
        <ul>
            {{range $i, $item := .Character.Apps}}
            <li style="display:flex; justify-content:space-between; align-items:center;">
                <span>{{$item}}</span>
                {{if $.CanEdit}}
                <form action="/character/{{$.Character.ID}}/delete_item" method="POST"
                      hx-post="/character/{{$.Character.ID}}/delete_item"
                      hx-target="#character-sheet-container" hx-swap="outerHTML"
                      hx-confirm="Are you sure you want to delete this nano/app?"
                      style="display:inline;">
                    <input type="hidden" name="type" value="app">
                    <input type="hidden" name="index" value="{{$i}}">
                    <button type="submit" class="btn-danger-small" title="Delete app">🗑️</button>
                </form>
                {{end}}
            </li>
            {{else}}
            <li style="color:var(--muted-color); list-style:none;">None</li>
            {{end}}
        </ul>
        {{if .CanEdit}}
        <form action="/character/{{.Character.ID}}/add_item" method="POST" hx-post="/character/{{.Character.ID}}/add_item" hx-target="#character-sheet-container" hx-swap="outerHTML" style="display:flex; gap:5px; margin-top:8px;">
            <input type="hidden" name="type" value="app">
            <input type="text" name="item" placeholder="New Nano/App..." class="edit-input" style="flex:1;" required>
            <button type="submit" class="btn" style="padding:4px 10px; font-size:0.8rem;">+ Add Nano/App</button>
        </form>
        {{end}}
    </div>
</div>
</div>
