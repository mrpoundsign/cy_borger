    <div class="party-container" hx-get="/game/{{.Game.ID}}/party" hx-target="this"
        hx-swap="outerHTML" hx-trigger="party-update from:body">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 15px;">
            <h2 style="color: var(--accent-color);">ACTIVE PARTY MEMBERS</h2>
            <div style="display:flex; flex-direction:column; gap:8px; align-items:flex-end;">
                <form action="/character/generate" method="POST" style="margin:0;">
                    <input type="hidden" name="game_id" value="{{.Game.ID}}">
                    <button type="submit" class="btn" style="width:100%;">🎲 Roll New Character</button>
                </form>
                <form action="/character/create_blank" method="POST" style="margin:0;">
                    <input type="hidden" name="game_id" value="{{.Game.ID}}">
                    <button type="submit" class="btn-outline" style="width:100%;">📝 Create Blank</button>
                </form>
            </div>
        </div>

        <div class="party-grid">
            {{$isGM := .IsGM}}
            {{$currentUserID := .CurrentUserID}}
            {{range .Characters}}
            {{if not .IsDead}}
            <div class="char-card" {{if and $currentUserID (eq .OwnerID
                $currentUserID)}}style="border-color: var(--accent-color); box-shadow: 0 0 12px rgba(255,230,0,0.25);"
                {{end}}>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div class="char-name">{{if .Name}}{{.Name}}{{else}}[UNNAMED OPERATOR]{{end}}</div>
                    {{if and $currentUserID (eq .OwnerID $currentUserID)}}
                    <span
                        style="background:var(--accent-color); color:#000; font-weight:bold; font-size:0.7rem; padding:2px 6px; border-radius:3px;">⚡
                        YOU!</span>
                    {{end}}
                </div>
                <div style="color:var(--muted-color); font-size:0.9rem; margin-bottom:10px;">
                    Player: {{if .OwnerUsername}}<strong
                        style="color:var(--accent-color);">{{.OwnerUsername}}</strong>{{else if
                    .Handle}}@{{.Handle}}{{else}}<span style="color:#777;">[Unnamed Player]</span>{{end}} —
                    {{.Class.Name}}
                </div>
                <div><strong>HP:</strong> {{.HP.Current}}/{{.HP.Max}} | <strong>Glitches:</strong>
                    {{.Glitches.Current}}/{{.Glitches.Max}}</div>
                <div style="margin-top:8px;"><strong>Weapons:</strong> {{range .Weapons}}{{.Name}} ({{.Damage}}{{if .Hands}}, {{.Hands}}{{end}}),
                    {{end}}</div>

                <div style="margin-top:12px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                    <button class="btn" hx-get="/character/{{.ID}}?modal=true" hx-target="#char-modal-container"
                        hx-swap="innerHTML" hx-select=".modal-overlay">
                        ⚡ INSPECT SHEET
                    </button>
                    <a href="/character/{{.ID}}" class="btn-outline">Full Sheet</a>

                    {{if or $isGM (and $currentUserID (eq .OwnerID $currentUserID))}}
                    <button class="btn-danger-small"
                        style="font-size:0.75rem; padding:4px 8px; background:#400015; border-color:#ff0055; color:#ff0055;"
                        onclick="toggleEditSection('kill-game-{{.ID}}', 'flex')">💀 KILL</button>

                    <div id="kill-game-{{.ID}}-edit"
                        style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center;">
                        <div
                            style="background:#0a0a0a; border:2px solid #ff0055; max-width:450px; width:90%; padding:25px; box-shadow:0 0 20px rgba(255,0,85,0.4); text-align:center;">
                            <h2 style="color:#ff0055; margin-bottom:10px;">💀 FLATLINE OPERATOR</h2>
                            <p style="color:#aaa; font-size:0.9rem; margin-bottom:15px; line-height:1.4;">
                                Mark <strong>{{.Name}}</strong> as deceased. Add a death note or final words:
                            </p>
                            <form action="/character/{{.ID}}/kill" method="POST" hx-post="/character/{{.ID}}/kill"
                                hx-swap="none"
                                style="display:flex; flex-direction:column; gap:12px;"
                                onsubmit="toggleEditSection('kill-game-{{.ID}}')">
                                <textarea name="death_note" placeholder="e.g. Flatlined by Cy-Spider in Sector 4"
                                    class="edit-input auto-stretch"
                                    style="border-color:#ff0055; font-size:0.95rem; min-height:60px;"></textarea>
                                <div style="display:flex; gap:10px; justify-content:center; margin-top:5px;">
                                    <button type="button" class="btn-outline"
                                        onclick="toggleEditSection('kill-game-{{.ID}}')">Cancel</button>
                                    <button type="submit" class="btn"
                                        style="background:#ff0055; color:#fff; border-color:#ff0055;">💀
                                        FLATLINE</button>
                                </div>
                            </form>
                        </div>
                    </div>
                    {{end}}
                </div>
            </div>
            {{end}}
            {{end}}
        </div>

        <div style="margin-top: 40px; border-top: 2px dashed #ff0055; padding-top: 20px;">
            <h2 style="color: #ff0055; display:flex; align-items:center; gap:8px;">🪦 GRAVEYARD / FLATLINED OPERATORS
            </h2>
            <div class="party-grid" style="margin-top:15px;">
                {{range .Characters}}
                {{if .IsDead}}
                <div class="char-card" style="border-color: #ff0055; background: #120006; opacity: 0.9;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div class="char-name" style="color:#ff0055; text-decoration:line-through;">☠️ {{if
                            .Name}}{{.Name}}{{else}}[UNNAMED OPERATOR]{{end}}</div>
                        <div>
                            {{if and $currentUserID (eq .OwnerID $currentUserID)}}
                            <span
                                style="background:var(--accent-color); color:#000; font-weight:bold; font-size:0.7rem; padding:2px 6px; border-radius:3px; margin-right:4px;">⚡
                                YOU!</span>
                            {{end}}
                            <span
                                style="background:#ff0055; color:#fff; font-weight:bold; font-size:0.7rem; padding:2px 6px; border-radius:3px;">FLATLINED</span>
                        </div>
                    </div>
                    <div style="color:var(--muted-color); font-size:0.85rem; margin-top:4px;">
                        Player: {{if .OwnerUsername}}<strong style="color:#ff99bb;">{{.OwnerUsername}}</strong>{{else if
                        .Handle}}@{{.Handle}}{{else}}<span style="color:#777;">[Unnamed Player]</span>{{end}} —
                        {{.Class.Name}}
                    </div>
                    {{if not .DiedAt.IsZero}}
                    <div style="font-size:0.75rem; color:#ff77a8; margin-top:4px; font-weight:bold;">🪦 DIED:
                        {{.DiedAt.Format "2006-01-02 15:04:05"}}</div>
                    {{end}}
                    <div
                        style="color:#ff99bb; font-style:italic; font-size:0.85rem; margin:10px 0; background:#20000a; padding:8px; border-left:3px solid #ff0055;">
                        "{{.DeathNote}}"
                    </div>
                    <div style="display:flex; gap:8px; align-items:center; margin-top:10px;">
                        <button class="btn"
                            style="background:#330011; border-color:#ff0055; color:#ff0055; font-size:0.75rem; padding:4px 8px;"
                            hx-get="/character/{{.ID}}?modal=true" hx-target="#char-modal-container" hx-swap="innerHTML"
                            hx-select=".modal-overlay">
                            ⚡ INSPECT SHEET
                        </button>
                        {{if or $isGM (and $currentUserID (eq .OwnerID $currentUserID))}}
                        <form action="/character/{{.ID}}/revive" method="POST" hx-post="/character/{{.ID}}/revive"
                            hx-swap="none" style="display:inline;">
                            <button type="submit" class="btn-outline"
                                style="font-size:0.75rem; padding:4px 8px; border-color:#00ff66; color:#00ff66;">⚡
                                REVIVE</button>
                        </form>
                        {{end}}
                    </div>
                </div>
                {{end}}
                {{end}}
            </div>
        </div>
    </div>
