package templates

templ About() {
	@Base("CY_BORGER - About", nil, AboutContent())
}

templ AboutContent() {
	<div class="container text-left" style="max-width: 600px; margin: 0 auto; padding-top: 2rem;">
		<h1 class="text-accent mb-lg">ABOUT CY_BORGER</h1>
		
		<div class="card mb-md">
			<h3 class="text-success mb-sm">THE PROJECT</h3>
			<p class="mb-sm">CY_BORGER is an open-source character generator and game management tool for the CY_BORG RPG.</p>
			<p><a href="https://github.com/mrpoundsign/cy_borger" target="_blank" rel="noopener noreferrer" class="text-accent no-decoration">🔗 View on GitHub</a></p>
		</div>

		<div class="card mb-md">
			<h3 class="text-warning mb-sm">ATTRIBUTION</h3>
			<p class="mb-sm">Full attribution and credit goes to <strong>makedatanotlore</strong> { "for" } the incredible character generation logic and data sets that make this tool possible.</p>
			<p><a href="https://linktr.ee/makedatanotlore" target="_blank" rel="noopener noreferrer" class="text-warning no-decoration">🔗 Support makedatanotlore</a></p>
		</div>

		<div class="card mb-md">
			<h3 class="text-danger mb-sm">CY_BORG</h3>
			<p class="text-muted text-sm mb-sm">
				CY_BORG is a game by Christian Sahlén and Johan Nohr. 
				CY_BORGER is an independent production and is not affiliated with Ockult Örtmästare Games or Stockholm Kartell.
			</p>
			<p><a href="https://cy-borg.io/" target="_blank" rel="noopener noreferrer" class="text-danger no-decoration">🔗 Official CY_BORG Website</a></p>
		</div>

		<div class="text-center mt-lg">
			<a href="/" class="btn-outline-small">← BACK TO HOME</a>
		</div>
	</div>
}
